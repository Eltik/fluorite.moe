# One-shot `endfield update` (via backend/scripts/auto-update.sh); fired by fluorite-update.timer. Skips the voice packages (--no-voice).
[Unit]
Description=fluorite.moe asset update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/fluorite.moe/backend
ExecStart=/var/www/fluorite.moe/backend/scripts/auto-update.sh --no-voice
Nice=10
IOSchedulingClass=idle
