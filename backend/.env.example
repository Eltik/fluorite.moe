# The configuration of the project. Copy it to `.env` and fill in the blanks:
#
#   cp backend/.env.example backend/.env
#
# Every variable is optional; the defaults in brackets are what the code uses when
# the variable is missing. The API and the unpacker read the same file.

# ── The server ───────────────────────────────────────────────

# The address the API listens on. Keep it on the loopback when a reverse proxy
# (nginx, Caddy) is in front of it. [127.0.0.1:8787]
FLUORITE_API_ADDR=127.0.0.1:8787

# Where the extraction output lives. The API reads the roots that are not in the
# bucket from here. Relative to the directory the process runs in; a server
# wants an absolute path. [backend/output]
#FLUORITE_OUTPUT=./output

# The thumbnail cache. [FLUORITE_OUTPUT/.cache]
#FLUORITE_CACHE_DIR=./output/.cache

# The file the unpacker writes the update state to. [backend/data/update-state.json]
#FLUORITE_STATE=./data/update-state.json

# How often the API looks for a new extraction, in seconds. [60]
FLUORITE_INDEX_POLL_SECS=60

# How often the API lists the bucket again when one is configured, in seconds, so
# files published after the last re-index show up. 0 disables it. [300]
#FLUORITE_BUCKET_RELIST_SECS=300

# The API base the browser uses. Empty means the same origin the page is served
# from, which is what the reverse proxy sets up. [same origin]
FLUORITE_PUBLIC_API_URL=

# The build-time fallback for the API base, used by `vite dev`. [same origin]
VITE_API_URL=

# Another file to read the configuration from. Empty means `backend/.env`.
FLUORITE_ENV_FILE=

# ── The downloads ────────────────────────────────────────────

# How many `.chk` chunks download at once. Lower it (1 or 2) on a slow link so
# each download finishes before the CDN stalls it. [4]
#FLUORITE_DOWNLOAD_CONCURRENCY=4

# Seconds between two runs of `scripts/update-loop.sh` (the pm2 `fluorite-update`
# process), from the end of one to the start of the next. [900]
#FLUORITE_UPDATE_INTERVAL=900

# ── The rigged models ───────────────────────────────────────

# Rebuild the rigged models after `scripts/auto-update.sh` ran an update that changed
# the state: scan, export, clips, charinfo, then publish. It downloads every bundle
# chunk once into `output/models/.store`, so the first run is long. A build that
# keeps failing is retried after 1, 2, 4… hours, at most a day. [off]
#FLUORITE_MODELS=1

# ── The audio ────────────────────────────────────────────────

# Read the voice packages from the game CDN instead of the local disk. [1]
FLUORITE_AUDIO_REMOTE=1

# Extra directories with `.pck` files, separated by `:`. []
FLUORITE_AUDIO_DIRS=

# The size cap of the transcoded clip cache, in megabytes. [5120]
FLUORITE_AUDIO_CACHE_MB=5120

# The tools the transcoder shells out to. [on the PATH]
FLUORITE_FFMPEG=ffmpeg
FLUORITE_VGMSTREAM=vgmstream-cli

# ── The object storage ───────────────────────────────────────
#
# The API serves the roots that live in the bucket and the unpacker publishes the
# new files into it. Without these the API reads the local disk only.
#
# The names are the ones the storage service uses for itself, so the values from a
# dashboard can be pasted in as they are. The generic `S3_*` name wins when both
# are set.

# The service: cloudflare (R2), b2, wasabi, digitalocean, aws, minio, seaweedfs or
# s3 for anything else. Without it the service is guessed from the endpoint host.
#
# The four settings below are the ones that switch the storage on. Uncomment them
# and fill them in — a half-filled configuration is a startup error, not a silent
# fallback to the disk.
#S3_TYPE=cloudflare

# The endpoint of the service.
# [https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com]
#S3_ENDPOINT=

# The bucket the objects live in.
#S3_BUCKET=assets

# The credentials.
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# The token for a session that is signed in, for the services that need one. []
S3_SESSION_TOKEN=

# The signing region. [from the service]
S3_REGION=auto

# Address the bucket as a path segment (`/<bucket>/<key>`) instead of a host
# prefix. [from the service]
S3_PATH_STYLE=1

# The roots that live in the bucket. The ones that are not listed stay on the
# local disk. [textures,meshes,models]
S3_ROOTS=textures,meshes,models

# The key prefix every object lives under, without slashes. [fluorite]
S3_PREFIX=fluorite

# The public URL of the bucket, the CDN in front of it. With it the API answers
# with a redirect instead of streaming the bytes itself. []
S3_PUBLIC_BASE_URL=https://assets.eltik.net

# The `Cache-Control` the objects are stored with. The cache rule of the CDN
# takes its time to live from this header. []
S3_CACHE_CONTROL="public, max-age=3600"

# How the API serves a root that lives in the bucket: `redirect` answers with the
# public URL, `proxy` streams the bytes through the server. [redirect when there
# is a public base URL, proxy otherwise]
S3_MODE=

# Serve the pre-generated thumbnails from the bucket as well. [1]
S3_THUMBS=1

# Keep the local copy of a file after it was uploaded. [1]
S3_KEEP_LOCAL=1

# How many files are uploaded at once. [16]
#S3_UPLOAD_CONCURRENCY=16

# ── Cloudflare R2 ────────────────────────────────────────────
#
# The names the R2 dashboard hands out. They are read when `S3_TYPE=cloudflare`
# and the generic `S3_*` name above is not set.

# The account id, in the endpoint next to the bucket list. It builds the endpoint
# when `CLOUDFLARE_S3_API` is not given.
#CLOUDFLARE_ACCOUNT_ID=

# The endpoint of the account.
#CLOUDFLARE_S3_API=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com

# The R2 API token (Manage R2 API Tokens -> Object Read & Write).
#CLOUDFLARE_API_ACCESS_KEY=
#CLOUDFLARE_API_SECRET_KEY=

# The Cloudflare API token, for the account API. It is not used by the storage
# layer; it is only needed by the tooling that manages the bucket itself.
#CLOUDFLARE_API_TOKEN=
